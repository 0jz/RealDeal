{
	"name": "realdeal",
	"version": "0.1.0",
	"description": "Buy and sell strategy for a shared cash goal, with concurrent Mozaik loops and deterministic simulated transactions.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node --import tsx src/server.ts",
		"build": "vite build --config web/vite.config.ts",
		"start": "node --import tsx src/server.ts --prod",
		"bot": "node --import tsx src/bot/main.ts",
		"check": "node --import tsx src/check.ts",
		"fixtures": "node --import tsx src/sources/fixtures/generate.ts",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web",
		"check:finance": "node --import tsx src/finance/check.ts"
	},
	"dependencies": {
		"@mozaik-ai/core": "6.0.0",
		"@number-flow/react": "^0.6.2",
		"@tailwindcss/vite": "^4.3.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"dotenv": "^17.4.2",
		"grammy": "^1.48.0",
		"lucide-react": "^1.81.0",
		"motion": "^14.14.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.8"
	},
	"engines": {
		"node": ">=22"
	}
}
