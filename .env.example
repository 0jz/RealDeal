# Optional. Used later by VerdictAgent for plain-language explanations.
# Without it, RealDeal falls back to template explanations.
OPENAI_API_KEY=

# Telegram bot (npm run bot). Create one with @BotFather: send /newbot and copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# Optional. Public https URL for webhook mode (not wired yet; the bot uses long polling without it).
# TELEGRAM_WEBHOOK_URL=

# Financial strategy: 0 = genuine asynchronous offline analysis, 1 = LLM reasoning.
# Live reasoning also requires OPENAI_API_KEY. No real transactions in either mode.
REALDEAL_LLM=0
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# PORT=8787
# LIVE_SOURCES=gigatron

# Scouts: how long one search may run (ms) and how many product pages each shop scout may read.
SCOUT_BUDGET_MS=300000
SCOUT_PAGES_PER_SITE=20
