# Copy to .env (or set real environment variables). Everything is optional:
# with no key the app runs in the clearly-labelled NO-KEY TEMPLATE MODE.

# --- Option A: OpenAI (Mozaik built-in model, OpenAI Responses API) ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini            # any built-in Mozaik model name, e.g. gpt-5.4-mini, gpt-5.4-nano, gpt-5.5
# LLM_REASONING_EFFORT=low          # passed only if the model supports it

# --- Option B: Anthropic / Gemini built-in models ---
# LLM_MODEL=claude-haiku-4-5        # needs ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=...
# LLM_MODEL=gemini-3.5-flash        # needs GEMINI_API_KEY
# GEMINI_API_KEY=...

# --- Option C: any OpenAI-compatible /chat/completions endpoint (OpenRouter, DeepSeek, Ollama, vLLM, ...) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...
# LLM_MODEL=openai/gpt-4o-mini

# Force the no-key template mode even if a key is present:
# LLM_MODE=template

# Server
PORT=3000
# HOST=0.0.0.0

# Optional: Mozaik Cloud telemetry (sends agent events, including prompts, to JigJoy's cloud). Off when unset.
# MOZAIK_API_KEY=...
