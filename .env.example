# Optional. Used later by VerdictAgent for plain-language explanations.
# Without it, RealDeal falls back to template explanations.
OPENAI_API_KEY=

# Telegram bot (npm run bot). Create one with @BotFather: send /newbot and copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# Optional. Public https URL for webhook mode (not wired yet; the bot uses long polling without it).
# TELEGRAM_WEBHOOK_URL=
